      "version": "0.1.0",
      "repo_url": "https://github.com/strmforge/vabhub-plugin-hello-world",
      "author_name": "VabHub 官方",
      "author_url": "https://github.com/strmforge",
      "channel": "official",
      "tags": ["example", "hello-world"],
      "extra": {}
    }
  ]
