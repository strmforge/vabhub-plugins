        "min_core_version": "0.9.0",
        "enabled_by_default": false,
        "supports": {
          "search": true,
          "bot_commands": true,
          "ui_panels": true,
          "workflows": false
        },
        "panels": [
          "home_dashboard"
        ]
      }
    }
